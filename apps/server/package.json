{
  "name": "@inframe/server",
  "private": true,
  "version": "0.2.6",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "node scripts/run-tests.mjs",
    "dev:worker": "tsx watch --clear-screen=false src/worker.ts",
    "worker": "node dist/worker.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "archiver": "^7.0.1",
    "dotenv": "^17.2.3",
    "exif-reader": "^2.0.2",
    "fastify": "^5.12.7",
    "ffmpeg-static": "^5.3.0",
    "googleapis": "~171.4.0",
    "heic-convert": "^2.1.0",
    "jose": "^6.2.12",
    "megajs": "^1.3.10",
    "nodemailer": "^7.0.10",
    "pg": "^8.23.1",
    "pg-boss": "^10.4.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@electric-sql/pglite-pgvector": "^0.0.12",
    "@electric-sql/pglite-socket": "^0.2.14",
    "@types/archiver": "^6.0.3",
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^20.19.0",
    "@types/nodemailer": "^7.0.2",
    "@types/pg": "^8.15.5",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
