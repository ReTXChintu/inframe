{
  "name": "inframe",
  "private": true,
  "version": "0.2.8",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,worker,web -c yellow,magenta,cyan \"npm:dev:server\" \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w apps/server",
    "dev:web": "npm run dev -w apps/web",
    "db:migrate": "npm run db:migrate -w apps/server",
    "build": "npm run build -w apps/web && npm run build -w apps/server",
    "start": "npm run start -w apps/server",
    "typecheck": "npm run typecheck -w apps/server && npm run typecheck -w apps/web",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "dev:worker": "npm run dev:worker -w apps/server"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
