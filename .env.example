# ─── InFrame configuration ─────────────────────────────────────────────
# Copy to `.env` in the repo root. The server reads this file; the web app
# talks to the server through the Vite dev proxy, so it needs nothing here.

# Where people open the app in a browser. In dev this is the Vite server
# (it proxies /api, /media and /socket.io to the API). In production the API
# serves the built web app itself, so this is the API's public URL.
APP_URL=http://localhost:5173
PORT=4000

# Neon Postgres. Use the *direct* connection string (host without "-pooler"):
# the job queue holds long-lived connections that PgBouncer would break.
# pgvector and citext are enabled by the first migration.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/inframe?sslmode=require

# Secrets. Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=
# Encrypts stored Google refresh tokens and MEGA passwords. Changing it
# invalidates every saved storage connection.
ENCRYPTION_KEY=
# Signs short-lived image URLs.
MEDIA_SECRET=

# Nothing is stored on the server's disk: originals AND their thumbnails /
# previews live in each event's Drive/MEGA folder (previews in a hidden
# ".inframe" sub-folder); selfies live in the database. This caps the
# in-memory cache of thumbnails fetched from storage.
MEDIA_CACHE_MB=256

# Development only: adds a "Dev memory storage" account so you can try the
# whole flow without Google/MEGA. Photos vanish on restart; refused in production.
DEV_MEMORY_STORAGE=false

# ─── Face model, Google Drive, Email ───────────────────────────────────
# All optional here. The first account to sign up is the super admin and can
# set (and override) every value below in the app: Admin → Settings.

# ─── Face model (external) ─────────────────────────────────────────────
# Base URL of the face service. It must expose POST /extract taking a
# multipart field "file" and returning {"faces": {...} | [...]} where each
# face has a 512-float "descriptor" (or "embedding").
MODEL_URL=
# Optional, sent on every request when set.
MODEL_API_KEY=
MODEL_API_KEY_HEADER=
MODEL_TIMEOUT_MS=
# Cosine similarity a face needs to count as a person (0–1, higher = stricter).
MATCH_THRESHOLD=

# ─── Google Drive (storage only — not used for login) ──────────────────
# Google Cloud console → APIs & Services → Credentials → OAuth client
# (type "Web application"). Enable the Google Drive API. Authorised
# redirect URI:  <APP_URL>/api/storage/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Email (password reset + event invites) ────────────────────────────
# Leave SMTP_HOST empty in development: emails are printed to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="InFrame <no-reply@example.com>"

# ─── Uploads & background work ────────────────────────────────────────
# Uploads are streamed to the server, wait in SPOOL_DIR, and a worker process
# (pm2 "inframe-worker" / npm run worker) stores them in Drive/MEGA, makes
# thumbnails and scans faces. Each spooled file is deleted once stored.
# Default spool: the OS temp dir. The API and workers must share it.
SPOOL_DIR=
MAX_UPLOAD_MB=50
MAX_VIDEO_MB=4096
# Parallel jobs per worker process, and which queues it serves (store,faces,sync).
WORKER_CONCURRENCY=3
WORKER_QUEUES=store,faces,sync
# Single-process setups: run the workers inside the API instead.
RUN_WORKERS_IN_API=false
# How often every event's folder is re-scanned for files added directly in Drive / MEGA.
SYNC_CRON=*/15 * * * *
